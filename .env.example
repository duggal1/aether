# Aether — Jev search credentials.
# Copy to .env (git-ignored) and fill in. Never commit real keys.

# TypeSafe Jev — search intelligence (intent, candidates, relevance ranking)
# https://console.typesafe.ai/keys
TYPESAFE_API_KEY=

# Search1API — web retrieval that Jev ranks
# https://s1.dev
SEARCH1API_API_KEY=

# Optional overrides
JEV_MODEL=jev-latest
TYPESAFE_ENDPOINT=https://api.typesafe.ai/v1/systemone
SEARCH1API_ENDPOINT=https://api.search1api.com/search
JEV_SEARCH_RESULTS=10
JEV_REQUEST_TIMEOUT=15

# Leave SEARCH1API_SERVICE unset for multi-engine retrieval with fused rankings.
# Setting it pins retrieval to one engine, for example:
#   SEARCH1API_SERVICE=google
